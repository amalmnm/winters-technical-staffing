---
const navItems = [
  { title: "Home", href: "/" },
  { title: "About", href: "/about" },
  { title: "Employers", href: "/employers" },
  { title: "Job Seekers", href: "/job-seekers" },
  { title: "Industries", href: "/industries" },
  { title: "Resources", href: "/resources" },
  { title: "Contact", href: "/contact" },
];

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 left-0 z-50 w-full bg-white shadow-sm"
>
  <div class="px-5 lg:px-10 xl:px-20">
    <div class="flex h-24 items-center justify-between">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img
        src="/images/logo.jpg"
        alt="Winters Technical Staffing"
        class="h-16 w-auto"
      />
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden xl:flex items-center gap-9">

      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-gray-900 hover:text-[#0D6EFD] transition-colors duration-300"
          >
            {item.title}
          </a>
        ))
      }

    </nav>

   <!-- Mobile -->

    <button class="xl:hidden text-3xl">
      ☰
    </button>

  </div>
  </div>
</header>