---
const navItems = [
  { title: "Job Seekers", href: "job-seekers" },
  { title: "Employers", href: "/about" },
  { title: "Industry Solutions", href: "/employers" },
  { title: "Knowledge Centre", href: "/job-seekers" },
  { title: "About Us", href: "/industries" },
  { title: "Contact", href: "/contact" },
];

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 left-0 z-50 w-full bg-white shadow-sm pt-[9px] pb-[18px]"
>
  <div class="px-5 lg:px-10 xl:px-20">
    <div class="flex h-24 items-center justify-between">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img
        src="/images/logo.jpg"
        alt="Winters Technical Staffing"
        class="h-[97] w-auto"
      />
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden xl:flex items-center">

      {
        navItems.map((item) => (
         <a
  href={item.href}
  class={`nav-link relative flex h-33 pt-[8px] items-center px-5 text-[19px] font-bold uppercase transition-all duration-300 hover:bg-[#0D6EFD] ${
    current === item.href 
    ? "bg-[#FABF01] !text-black hover:bg-[#FABF01] hover:!text-black" 
    : "!text-[#116081] hover:bg-[#FABF01] hover:!text-black active:bg-[#FABF01] active:!text-black"
  }`}
>
  {item.title}
</a>

        ))
      }

    </nav>

   <!-- Mobile -->

    <button class="xl:hidden text-3xl">
      ☰
    </button>

  </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>