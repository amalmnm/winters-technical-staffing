---
const jobs = [
  "View All Jobs",
  "Join Our Talent Network",
  "Application Resources",
  "Job Seeker FAQ's",
];

const staffing = [
  "Business Solutions",
  "Our Approach",
  "Employer FAQ's",
];

const about = [
  "Who We Are",
  "Testimonials",
  "Sponsorships",
];

const policy = [
  "Health and Safety Policy",
  "Workplace Violence and Harassment Policy",
  "Accessibility Standards for Customer Service",
  "Privacy Policy",
];
---

<footer class="bg-[#262626] text-white bg-repeat-x bg-top" 
style="background-image: url('/images/footer-line.png');">

  <div class="mx-auto max-w-[1220px] px-5 py-20">

    <div class="grid gap-16 lg:grid-cols-2">

      <!-- Left -->
      <div class="grid lg:grid-cols-[55%_45%] gap-12">

        <div>
          <h3 class="mb-4 text-[20px] font-semibold text-white">
            Find the Right Position
            <span class="mt-2 block h-[3px] w-[106px] bg-white"></span>
          </h3>

          <ul class="space-y-3">
            {jobs.map((item,index)=>(
              <li>
                <a
                  href="#"
                  class={`transition hover:text-[#F9B233] ${
                    index===0 ? "text-[#F9B233]" : ""
                  }`}
                >
                  {item}
                </a>
              </li>
            ))}
          </ul>

          <h3 class="mt-14 mb-6 text-[20px] font-semibold text-white">
            Staffing Solutions
            <span class="mt-2 block h-[3px] w-[106px] bg-white"></span>
          </h3>

          <ul class="space-y-3">
            {staffing.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

        </div>

        <div>

          <h3 class="mb-6  text-[20px] font-semibold text-white">
            About Winters
            <span class="mt-2 block h-[3px] w-[106px] bg-white"></span>
          </h3>

          <ul class="space-y-3">
            {about.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

          <h3 class="mt-14 mb-6 text-[20px] font-semibold text-white">
            Our Policies
            <span class="mt-2 block h-[3px] w-[106px] bg-white"></span>
          </h3>

          <ul class="space-y-3">
            {policy.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

        </div>

      </div>

      <!-- Locations -->
      <div class="lg:col-span-1">

        <h3 class="mb-8  pb-2 text-[20px] font-semibold text-white">
          Our Locations
          <span class="mt-2 block h-[3px] w-[106px] bg-white"></span>
        </h3>

        <div class="grid gap-10 md:grid-cols-2">

          <!-- Toronto -->
          <div>

            <h4 class="mb-4 text-xl font-semibold text-white">
              Head Office – Toronto
            </h4>

            <img
              src="/images/map-toronto.png"
              alt=""
              class="mb-5 h-[140px] w-full rounded object-cover"
            />

            <ul class="space-y-3 text-sm leading-7">
              <li>📍 505 Consumers Road, Suite 306 Toronto, Ontario, Canada M2J 4V8</li>
              <li>☎ Phone:222-222-222</li>
              <li>📠 Fax: 222-222-222</li>
            </ul>

          </div>

          <!-- Ajax -->
          <div>

            <h4 class="mb-4 text-xl font-semibold text-white">
              Ajax Office
            </h4>

            <img
              src="/images/map-toronto.png"
              alt=""
              class="mb-5 h-[140px] w-full rounded object-cover"
            />

            <ul class="space-y-3 text-sm leading-7">
              <li>📍 230 Westney Road, Suite 302 Ajax, Ontario, Canada L1S 7J5</li>
              <li>☎ Phone: 333-333-3857</li>
              <li>📞 Toll Free: 1-324-444-5467</li>
              <li>📠 Fax: 234-231-2345</li>
            </ul>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Bottom -->
  <div class="border-t border-[#444]">

    <div class="mx-auto flex max-w-[1220px] flex-col items-center justify-between gap-8 px-5 py-8 md:flex-row">

      <img
        src="/images/footer-logo.png"
        alt="Logo"
        class="h-[72px] w-auto"
      />

      <div class="flex gap-3">

        <a href="#" class="flex justify-center">
           <img
        src="/images/icon-facebook.png"
        alt="Facebook"
        class="h-8 w-auto"
      />
        </a>

        <a href="#" class="flex justify-center ">
         <img
        src="/images/icon-linkedin.png"
        alt="linkedin"
        class="h-8 w-auto"
      />
        </a>

        <a href="#" class="flex justify-center">
         <img
        src="/images/icon-twitter.png"
        alt="twitter"
        class="h-8 w-auto"
      />
        </a>

      </div>

   

    </div>

  </div>

</footer>