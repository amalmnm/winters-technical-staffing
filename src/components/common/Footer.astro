---
const jobs = [
  "View All Jobs",
  "Join Our Talent Network",
  "Application Resources",
  "Job Seeker FAQ's",
];

const staffing = [
  "Business Solutions",
  "Our Approach",
  "Employer FAQ's",
];

const about = [
  "Who We Are",
  "Testimonials",
  "Sponsorships",
];

const policy = [
  "Health and Safety Policy",
  "Workplace Violence and Harassment Policy",
  "Accessibility Standards for Customer Service",
  "Privacy Policy",
];
---

<footer class="bg-[#2D2D2D] text-gray-300">

  <div class="mx-auto max-w-[1220px] px-5 py-20">

    <div class="grid gap-16 lg:grid-cols-3">

      <!-- Left -->
      <div class="grid gap-12 sm:grid-cols-2">

        <div>
          <h3 class="mb-6 border-b border-gray-500 pb-2 text-2xl font-semibold text-white">
            Find the Right Position
          </h3>

          <ul class="space-y-3">
            {jobs.map((item,index)=>(
              <li>
                <a
                  href="#"
                  class={`transition hover:text-[#F9B233] ${
                    index===0 ? "text-[#F9B233]" : ""
                  }`}
                >
                  {item}
                </a>
              </li>
            ))}
          </ul>

          <h3 class="mt-14 mb-6 border-b border-gray-500 pb-2 text-2xl font-semibold text-white">
            Staffing Solutions
          </h3>

          <ul class="space-y-3">
            {staffing.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

        </div>

        <div>

          <h3 class="mb-6 border-b border-gray-500 pb-2 text-2xl font-semibold text-white">
            About Winters
          </h3>

          <ul class="space-y-3">
            {about.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

          <h3 class="mt-14 mb-6 border-b border-gray-500 pb-2 text-2xl font-semibold text-white">
            Our Policies
          </h3>

          <ul class="space-y-3">
            {policy.map(item=>(
              <li><a href="#" class="hover:text-[#F9B233]">{item}</a></li>
            ))}
          </ul>

        </div>

      </div>

      <!-- Locations -->
      <div class="lg:col-span-2">

        <h3 class="mb-8 border-b border-gray-500 pb-2 text-2xl font-semibold text-white">
          Our Locations
        </h3>

        <div class="grid gap-10 md:grid-cols-2">

          <!-- Toronto -->
          <div>

            <h4 class="mb-4 text-xl font-semibold text-white">
              Head Office – Toronto
            </h4>

            <img
              src="/images/map-toronto.jpg"
              alt=""
              class="mb-5 h-[140px] w-full rounded object-cover"
            />

            <ul class="space-y-3 text-sm leading-7">
              <li>📍 505 Consumers Road, Suite 306 Toronto, Ontario, Canada M2J 4V8</li>
              <li>☎ Phone: 647-556-2408</li>
              <li>📠 Fax: 416-495-8479</li>
            </ul>

          </div>

          <!-- Ajax -->
          <div>

            <h4 class="mb-4 text-xl font-semibold text-white">
              Ajax Office
            </h4>

            <img
              src="/images/map-ajax.jpg"
              alt=""
              class="mb-5 h-[140px] w-full rounded object-cover"
            />

            <ul class="space-y-3 text-sm leading-7">
              <li>📍 230 Westney Road, Suite 302 Ajax, Ontario, Canada L1S 7J5</li>
              <li>☎ Phone: 905-231-3857</li>
              <li>📞 Toll Free: 1-866-371-1014</li>
              <li>📠 Fax: 905-231-3860</li>
            </ul>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Bottom -->
  <div class="border-t border-[#444]">

    <div class="mx-auto flex max-w-[1220px] flex-col items-center justify-between gap-8 px-5 py-8 md:flex-row">

      <img
        src="/images/footer-logo.png"
        alt="Logo"
        class="h-16"
      />

      <div class="flex gap-3">

        <a href="#" class="flex h-10 w-10 items-center justify-center rounded bg-[#1877F2] text-white">
          <i class="fa-brands fa-facebook-f"></i>
        </a>

        <a href="#" class="flex h-10 w-10 items-center justify-center rounded bg-[#0A66C2] text-white">
          <i class="fa-brands fa-linkedin-in"></i>
        </a>

        <a href="#" class="flex h-10 w-10 items-center justify-center rounded bg-[#1DA1F2] text-white">
          <i class="fa-brands fa-twitter"></i>
        </a>

      </div>

      <div class="text-center text-sm text-gray-400 md:text-right">
        <p>Copyright © 2022 Winters Technical Staffing</p>
        <p class="mt-2">
          Website by
          <span class="text-[#F9B233]">WSI Comandix</span>
        </p>
      </div>

    </div>

  </div>

</footer>