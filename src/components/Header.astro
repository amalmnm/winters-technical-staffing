---
const navItems = [
  { title: "Home", href: "/" },
  { title: "About", href: "/about" },
  { title: "Employers", href: "/employers" },
  { title: "Job Seekers", href: "/job-seekers" },
  { title: "Industries", href: "/industries" },
  { title: "Resources", href: "/resources" },
  { title: "Contact", href: "/contact" },
];
---

<header class="w-full bg-white border-b">

    <div class="flex items-center justify-between px-6 lg:px-10 py-4">

    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0">
      <img
        src="/images/logo.jpg"
        alt="Winters Technical Staffing"
        class="h-16 w-auto object-contain"
      />
    </a>

    <!-- Navigation -->
    <nav class="hidden xl:flex items-center gap-8">

      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-[16px] font-semibold text-slate-700 hover:text-[#0B5ED7] transition-colors duration-300"
          >
            {item.title}
          </a>
        ))
      }

    </nav>

    <!-- Buttons -->
    

    <!-- Mobile -->
    <button class="xl:hidden text-3xl font-bold">
      ☰
    </button>

  </div>

</header>