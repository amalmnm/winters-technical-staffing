---
import { getCollection } from "astro:content";

const pages = await getCollection("pages");

const home = pages.find(
  (page) => page.id === "home"
);

const data = home.data;
---




<section class="relative flex min-h-screen flex-col xl:flex-row">

  <!-- Left Side -->
  <div
    class="rrelative flex h-screen w-full items-end justify-end bg-cover bg-center xl:w-1/2"
    style="background-image: url('/images/job-seeker.jpg');"
  >
    

    <div class="relative z-10 w-full justify-end px-8 pb-10 lg:px-16 xl:px-24">
      <div class="max-w-xl text-right">      
        <h1 class="mb-6 text-5xl font-bold leading-tight text-white xl:text-6xl" set:html={data.heroTextLleft}></h1>
        <a
          href={home.data.heroTextLleftBttonLink}
          class="inline-flex rounded-md bg-[#0D6EFD] px-8 py-4 font-semibold text-white transition hover:bg-[#0B5ED7]"
        >
          {home.data.heroTextLleftBttonText} 
        </a>

      </div>
    </div>
  </div>

  <!-- Right Side -->
  <div
    class="relative flex w-full items-end bg-cover bg-center xl:w-1/2"
    style="background-image: url('/images/employer.jpg');"
  >
    

    <div class="relative z-10 w-full px-8 pb-10 lg:px-16 xl:px-24">
      <div class="ml-auto max-w-xl">

        

        <h2 class="mb-6 text-5xl font-bold leading-tight text-white xl:text-6xl">
          Discover Our <br />
          Business Solutions
        </h2>

        

        <a
          href="/employers"
          class="inline-flex rounded-md bg-[#0D6EFD] px-8 py-4 font-semibold text-white transition hover:bg-[#0B5ED7]"
        >
          Learn More
        </a>

      </div>
    </div>
  </div>

</section>