---
import { getCollection } from "astro:content";

const pages = await getCollection("pages");

const home = pages.find(
  (page) => page.id === "home"
);

const data = home.data;
---




<section class="relative flex min-h-[calc(100vh-122px)] flex-col xl:flex-row">

  <!-- Left Side -->
  <div
    class="rrelative flex h-[calc(100vh-122px)] w-full items-end justify-end bg-cover bg-center xl:w-1/2"
    style="background-image: url('/images/job-seeker.jpg');"
  >
    

    <div class="relative z-10 flex w-full justify-end pr-10 pb-10">
      <div class="max-w-xl text-right">      
        <h1 class="mb-6 text-5xl font-bold leading-[0.9] text-white xl:text-6xl" set:html={data.heroTextLleft}></h1>
        <a
          href={home.data.heroTextLleftBttonLink}
          class="btn inline-flex items-center gap-2  pl-[17px] pr-[60px] py-2 font-semibold  transition duration-300" >
          {home.data.heroTextLleftBttonText} 
           
        </a>

      </div>
    </div>
  </div>

  <!-- Right Side -->
  <div
    class="relative flex w-full items-end bg-cover bg-center xl:w-1/2"
    style="background-image: url('/images/employer.jpg');"
  >
    

    <div class="relative  flex z-10 w-full pl-10 pb-10 lg:pr-16 xl:pr-24">
      <div class=" max-w-xl">

        

        <h2 class="mb-6 text-5xl font-bold leading-[0.9] text-white xl:text-6xl">
          Discover Our <br />
          Business Solutions
        </h2>

        

        <a
          href="/employers"
          class="btn inline-flex items-center gap-2  pl-[17px] pr-[60px] py-2 font-semibold  transition duration-300"
        >
          Find Out More
        </a>

      </div>
    </div>
  </div>

</section>