---
import "../styles/global.css";

import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";

interface Props{
title?:string;
description?:string;
}

const {
title="Winters Technical Staffing",
description="Technical Staffing"
}=Astro.props;
---

<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1">
<link
    href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

<title>{title}</title>

<meta
name="description"
content={description}
/>

</head>

<body>

<Header />

<main>

<slot />

</main>

<Footer />

</body>

</html>